# Copy to .env and fill in. NEVER commit .env, keypairs, or API keys. Devnet only.

# Backend
API_PORT=8000

# Tiger Data / TimescaleDB (local dev via Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gpushare

# Solana (devnet only)
SOLANA_RPC_URL=https://api.devnet.solana.com
# PAYOUT_KEYPAIR_PATH=~/.config/solana/devnet.json

# Auth
JWT_SECRET=dev-only-change-me
